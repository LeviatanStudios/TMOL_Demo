  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TaskManager
  tasks:
  - taskName: Flashlight
    tutorialMessage: Press [F] for Flashlight
    isCompleted: 0
  - taskName: TryFrontDoor
    tutorialMessage: There must be something outside
    isCompleted: 0
  - taskName: CollectBattery
    tutorialMessage: Collect Batteries from Piano bench
    isCompleted: 0
  - taskName: PickJournal
    tutorialMessage: "Pick up Do\xF1a Isabel's Journal #1 from the living room"
    isCompleted: 0
  - taskName: GoDiningHall
    tutorialMessage: Explore the Dining Hall.
    isCompleted: 0
  - taskName: ReadStudyNote
    tutorialMessage: Check the note in front of study room.
    isCompleted: 0
  - taskName: ExploreServant
    tutorialMessage: "Enter the Servant\u2019s Quarters."
    isCompleted: 0
  - taskName: CollectMatches
    tutorialMessage: "Pick up Matches (x1) in Servant\u2019s Quarters."
    isCompleted: 0
  - taskName: EnterLibrary
    tutorialMessage: Enter the Library to find the Study Key.
    isCompleted: 0
  - taskName: SolveBookPuzzle
    tutorialMessage: "Use the Flashlight to read the occult books and find the book
      titled 'The Patriarch\u2019s Burden."
    isCompleted: 0
  - taskName: GetStudyKey
    tutorialMessage: Take the Study Key revealed by the book.
    isCompleted: 0
  - taskName: UnlockStudy
    tutorialMessage: "Use the Study Key to enter Don Ramon\u2019s Study."
    isCompleted: 0
  - taskName: ReadFinalJournal
    tutorialMessage: "Read Don Ramon\u2019s final journal entry."
    isCompleted: 0
  - taskName: Run
    tutorialMessage: Run
    isCompleted: 0
  tutorialManager: {fileID: 1646687465}
