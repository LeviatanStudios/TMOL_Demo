  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Ramon has locked himself in his Study again. He swears it is for our family''s
    future, yet he trembles whenever that contract is mentioned. The servants hear
    scratching inside the walls, but he insists it is only termites.



    I know
    what fear looks like in a man. This is something worse.



    If he will not
    open the door, then perhaps the Library holds the answers he hides from me.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
