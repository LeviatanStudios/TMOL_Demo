  m_Script: {fileID: 11500000, guid: 8c506c35273dbfc47832f1c73bd01283, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JournalPickup
  journalID: PickJournal
  journalTitle: "Isabel\u2019s Fears"
  journalContent: 'Ramon has locked himself in his Study again. He swears it is for
    our family''s future, yet he trembles whenever that contract is mentioned. The
    servants hear scratching inside the walls, but he insists it is only termites.



    I
    know what fear looks like in a man. This is something worse.



    If he will
    not open the door, then perhaps the Library holds the answers he hides from me.'
  journalImage: {fileID: 0}
