  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::JournalPickup
  journalID: ReadFinalJournal
  journalTitle: The Book He Feared
  journalContent: "Ramon returned this book with shaking hands. He said its words
    watched him. He said the house listened when he read aloud.\r\n\r\nHe hid the
    key inside the one volume he feared most:\r\n\u201CThe Patriarch\u2019s Burden.\u201D\r\n\r\nDo
    not ignore the crying. It is not calling for help."
  journalImage: {fileID: 0}
